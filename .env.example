TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_BOT_USERNAME=replace-with-bot-username
TELEGRAM_PROXY_URL=
STAFF_EMAIL_OTP_ENABLED=false
STAFF_EMAIL_DOMAIN=ze.studio
STAFF_EMAIL_FROM=info@ze.studio
STAFF_EMAIL_SMTP_HOST=smtp.yandex.ru
STAFF_EMAIL_SMTP_PORT=465
STAFF_EMAIL_SMTP_USERNAME=info@ze.studio
STAFF_EMAIL_SMTP_PASSWORD=
DATABASE_URL=sqlite:///./hr_bot.db
TIMEZONE=Europe/Moscow
DOTENV_OVERRIDE=false

# Demo mode for quick local checks
DEMO_MODE=true
DEMO_STEP_MINUTES=1
MANUAL_STEP_MINUTES=1

# Scenario settings
PROBATION_WORKDAYS=40
TEST_URL=https://example.com/test
PRACTICE_URL=https://example.com/practice
TASKS_URL=https://example.com/tasks
FEEDBACK_URL=https://example.com/feedback

# Local file storage
FILE_STORAGE_DIR=./storage/employee_files

# Admin panel session secret
ADMIN_SESSION_SECRET=change-me-admin-session-secret
ADMIN_SESSION_MAX_AGE_SECONDS=43200
ADMIN_SESSION_COOKIE_SECURE=false

# Pulse integration: bearer token for GET /api/integrations/pulse/employees (empty = disabled)
PULSE_SYNC_TOKEN=

# Default admin accounts created on startup
DEFAULT_ADMIN_LOGIN=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_HR_LOGIN=hr
DEFAULT_HR_PASSWORD=hr123
